{
  "name": "Echelon Quant",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "pip install -r backend/requirements/dev.txt",
  "forwardPorts": [8000, 8001, 8002, 8003, 5432, 6379],
  "portsAttributes": {
    "8000": { "label": "api-gateway" },
    "8001": { "label": "account-service" },
    "8002": { "label": "bot-service" },
    "8003": { "label": "market-data-service" },
    "5432": { "label": "postgres" },
    "6379": { "label": "redis" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
