# These keys map 1:1 to fields on backend/shared/config.py:Settings.
# database_url / redis_url are computed properties, not settable env vars - don't add them here.
ENVIRONMENT=development
APP_NAME=Echelon Quant
DEBUG=false

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=echelon_quant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_STREAM_MARKET_EVENTS=market-events
REDIS_STREAM_BOT_EVENTS=bot-events
REDIS_STREAM_ORDER_EVENTS=order-events
REDIS_STREAM_POSITION_EVENTS=position-events
REDIS_STREAM_RISK_EVENTS=risk-events

# Optional Deriv credentials (leave empty to use the public, unauthenticated feed).
DERIV_TOKEN=
DERIV_ACCOUNT_ID=
DERIV_APP_ID=
# Fernet key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
DERIV_TOKEN_KEY=

# api-gateway proxies /api/v1/bots* requests to bot-service at this URL.
BOT_SERVICE_URL=http://bot-service:8000