# These keys map 1:1 to fields on backend/shared/config.py:Settings.
# database_url / redis_url are computed properties, not settable env vars - don't add them here.
ENVIRONMENT=development
APP_NAME=Echelon Quant
DEBUG=false

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=echelon_quant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_STREAM_MARKET_EVENTS=market-events
REDIS_STREAM_BOT_EVENTS=bot-events
REDIS_STREAM_ORDER_EVENTS=order-events
REDIS_STREAM_POSITION_EVENTS=position-events
REDIS_STREAM_RISK_EVENTS=risk-events

# Optional Deriv credentials (leave empty to use the public, unauthenticated feed).
# DERIV_APP_ID: register an app at https://api.deriv.com to get one.
# DERIV_TOKEN: app.deriv.com -> Settings -> Security -> API token, scoped
#   read + trade, with the demo (VRTC...) account selected. Do not grant
#   admin or payments.
DERIV_TOKEN=
DERIV_ACCOUNT_ID=
DERIV_APP_ID=
# Fernet key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
DERIV_TOKEN_KEY=

# Deriv legacy v3 API, used for multiplier contracts (stop loss, take profit and
# trailing). This is a different API from the Options one DERIV_TOKEN above also
# serves; see backend/shared/deriv_v3_client.py.
DERIV_V3_WS_URL=wss://ws.derivws.com/websockets/v3
# demo | real. Execution refuses to place orders unless this is demo.
DERIV_TRADE_MODE=demo
DERIV_MULTIPLIER=100
DERIV_STAKE=10
DERIV_CURRENCY=USD

# api-gateway proxies /api/v1/bots* requests to bot-service at this URL.
BOT_SERVICE_URL=http://bot-service:8000
